# Пример настроек. Скопируйте в .env, если нужно поменять значения:
#   cp .env.example .env
# Без .env используются значения по умолчанию из docker-compose.yml (они совпадают с этими).
# Пароли здесь только для локального стенда, в реальном окружении их задают иначе.

# Порты на хосте. Меняйте, если порт уже занят.
KAFKA_HOST_PORT=9092
POSTGRES_HOST_PORT=5433
KAFKA_UI_HOST_PORT=8080
INVENTORY_HOST_PORT=8001

# Суперпользователь PostgreSQL: нужен только скрипту, который создаёт базы.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# У каждого сервиса своя база и свой пользователь.
ORDER_DB_USER=order_service
ORDER_DB_PASSWORD=order_service
INVENTORY_DB_USER=inventory_service
INVENTORY_DB_PASSWORD=inventory_service
ANTIFRAUD_DB_USER=antifraud_service
ANTIFRAUD_DB_PASSWORD=antifraud_service
